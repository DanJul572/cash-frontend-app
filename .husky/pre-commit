#!/usr/bin/env sh

# ── Colors ────────────────────────────────────────────────
GREEN="$(printf '\033[0;32m')"
RED="$(printf '\033[0;31m')"
CYAN="$(printf '\033[0;36m')"
DIM="$(printf '\033[2m')"
BOLD="$(printf '\033[1m')"
RESET="$(printf '\033[0m')"

LOG_FILE="/tmp/husky-step-output.log"

# Spinner characters (dipisah spasi, bukan array Bash)
SPIN_CHARS="⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏"

run_step() {
  icon="$1"
  label="$2"
  cmd="$3"

  eval "$cmd" >"$LOG_FILE" 2>&1 &
  pid=$!

  i=0
  start=$(date +%s)

  while kill -0 "$pid" 2>/dev/null; do
    set -- $SPIN_CHARS

    idx=$((i % $# + 1))

    n=1
    for c in "$@"; do
      if [ "$n" -eq "$idx" ]; then
        char="$c"
        break
      fi
      n=$((n + 1))
    done

    printf "\r${CYAN}%s${RESET}  %s  %s" "$char" "$icon" "$label"

    i=$((i + 1))
    sleep 0.1
  done

  wait "$pid"
  status=$?

  end=$(date +%s)
  elapsed=$((end - start))

  if [ "$status" -eq 0 ]; then
    printf "\r${GREEN}✅${RESET}  %s  %s  ${DIM}(%ss)${RESET}\n" \
      "$icon" "$label" "$elapsed"
  else
    printf "\r${RED}❌${RESET}  %s  %s  ${DIM}(%ss)${RESET}\n" \
      "$icon" "$label" "$elapsed"

    echo
    printf "${RED}${BOLD}── Output ──────────────────────────────${RESET}\n"
    cat "$LOG_FILE"
    printf "${RED}${BOLD}────────────────────────────────────────${RESET}\n"
    echo
    printf "${RED}${BOLD}✖ Commit aborted at: %s${RESET}\n" "$label"
    exit 1
  fi
}

echo
printf "${BOLD}🚀 Running pre-commit checks...${RESET}\n"
echo

run_step "🧭" "Generating TanStack routes" "pnpm exec tsr generate"
run_step "🎨" "Formatting code" "pnpm format:silent && git add -u"
run_step "🧹" "Linting" "pnpm lint"
run_step "🧠" "Type checking" "pnpm typecheck"
run_step "🧪" "Running tests" "pnpm test:silent"

echo
printf "${GREEN}${BOLD}✨ All checks passed! Ready to commit.${RESET}\n"
echo