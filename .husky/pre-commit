#!/bin/sh

echo "🔧 Running TanStack Router generate..."
pnpm exec tsr generate

echo "🔍 Running format..."
pnpm format
git add -u

echo "🔍 Running lint..."
pnpm lint

echo "🔍 Running typecheck..."
pnpm typecheck

echo "🔍 Running tests..."
if pnpm test:silent > /dev/null 2>&1; then
  echo "✅ All tests passed!"
else
  echo "❌ Tests failed. Commit aborted."
  exit 1
fi

echo "✅ All checks passed!"