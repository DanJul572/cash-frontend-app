{
  "name": "cash-frontend-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:app": "tsc -b && vite build --config vite.app.config.ts",
    "build:all": "pnpm --filter \"./apps/*\" build && pnpm build:app",
    "build:dev": "tsc -b && vite build --config vite.app.config.ts --mode development",
    "build:stage": "tsc -b && vite build --config vite.app.config.ts --mode staging",
    "build:prod": "tsc -b && vite build --config vite.app.config.ts --mode production",
    "dev": "vite --config vite.app.config.ts",
    "dev:all": "pnpm --parallel --filter . --filter \"./apps/*\" dev",
    "format": "prettier . --write",
    "format:silent": "prettier . --write --log-level=silent",
    "lint": "eslint .",
    "prepare": "husky",
    "preview": "vite preview --config vite.app.config.ts",
    "preview:all": "pnpm --parallel --filter . --filter \"./apps/*\" preview",
    "publish:verdaccio": "node publish.cjs",
    "test:coverage": "vitest --globals --coverage",
    "test:silent": "vitest run --globals --silent",
    "test": "vitest --globals",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && pnpm --filter \"./packages/*\" --filter \"./apps/*\" typecheck",
    "update:deps": "pnpm update -r --latest"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@eslint/js": "catalog:",
    "@fontsource/roboto": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@iconify/react": "catalog:",
    "@module-federation/vite": "catalog:",
    "@mui/material": "catalog:",
    "@mui/x-charts": "catalog:",
    "@mui/x-data-grid": "catalog:",
    "@mui/x-date-pickers": "catalog:",
    "@mui/x-tree-view": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@trivago/prettier-plugin-sort-imports": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zapplib/core": "workspace:*",
    "@zapplib/ui": "workspace:*",
    "axios": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "dayjs": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "i18next": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-i18next": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "packageManager": "pnpm@12.6.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
