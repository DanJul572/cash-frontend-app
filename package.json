{
    "name": "cash-app",
    "private": false,
    "version": "1.0.0",
    "type": "module",
    "main": "./dist/index.es.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build:app": "tsc -b && vite build --config vite.app.config.ts",
        "build:dev": "tsc -b && vite build --config vite.app.config.ts --mode development",
        "build:stage": "tsc -b && vite build --config vite.app.config.ts --mode staging",
        "build:prod": "tsc -b && vite build --config vite.app.config.ts --mode production",
        "build:lib": "tsc -b && vite build --config vite.lib.config.ts",
        "dev": "vite --config vite.app.config.ts",
        "format": "prettier . --write",
        "format:silent": "prettier . --write --log-level=silent",
        "lint": "eslint .",
        "prepare": "husky",
        "prepublishOnly": "pnpm build:lib",
        "preview": "vite preview --config vite.app.config.ts",
        "publish:verdaccio": "node publish.cjs",
        "test:coverage": "vitest --globals --coverage",
        "test:silent": "vitest run --globals --silent",
        "test": "vitest --globals",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
        "update:deps": "ncu -u --cooldown 1"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/roboto": "^5.3.0",
        "@hookform/resolvers": "^5.5.7",
        "@mui/icons-material": "^9.2.0",
        "@mui/material": "^9.2.0",
        "@mui/x-charts": "^9.10.1",
        "@mui/x-data-grid": "^9.10.1",
        "@mui/x-date-pickers": "^9.10.1",
        "@mui/x-tree-view": "^9.10.1",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-query-devtools": "^5.101.4",
        "@tanstack/react-router": "^1.170.18",
        "@tanstack/react-router-devtools": "^1.167.0",
        "axios": "^1.19.0",
        "dayjs": "^1.11.21",
        "i18next": "^26.3.6",
        "pnpm": "11.18.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.83.0",
        "react-i18next": "^17.0.11",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@eslint/js": "^10.0.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tanstack/router-cli": "^1.167.21",
        "@tanstack/router-plugin": "^1.168.23",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "@vitest/coverage-v8": "4.1.10",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "msw": "^2.15.0",
        "npm-check-updates": "^23.0.0",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vite-plugin-dts": "^5.0.3",
        "vitest": "^4.1.10"
    },
    "packageManager": "pnpm@11.18.0",
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
