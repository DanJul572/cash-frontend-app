{
  "name": "cash-app",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:app": "tsc -b && vite build --config vite.app.config.ts",
    "build:dev": "tsc -b && vite build --config vite.app.config.ts --mode development",
    "build:stage": "tsc -b && vite build --config vite.app.config.ts --mode staging",
    "build:prod": "tsc -b && vite build --config vite.app.config.ts --mode production",
    "build:lib": "tsc -b && vite build --config vite.lib.config.ts",
    "dev": "vite --config vite.app.config.ts",
    "format": "prettier . --write",
    "format:silent": "prettier . --write --log-level=silent",
    "lint": "eslint .",
    "prepare": "husky",
    "prepublishOnly": "pnpm build:lib",
    "preview": "vite preview --config vite.app.config.ts",
    "publish:verdaccio": "node publish.cjs",
    "test:coverage": "vitest --globals --coverage",
    "test:silent": "vitest run --globals --silent",
    "test": "vitest --globals",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "update:deps": "ncu -u --cooldown 1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-charts": "^9.13.0",
    "@mui/x-data-grid": "^9.13.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@mui/x-tree-view": "^9.13.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-router-devtools": "^1.167.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "pnpm": "12.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.13",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/router-cli": "^1.167.35",
    "@tanstack/router-plugin": "^1.168.37",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
