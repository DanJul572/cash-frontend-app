{
  "name": "@zapplib/ui",
  "private": false,
  "version": "2.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/lib/components/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./components/*": {
        "types": "./dist/types/lib/components/*.d.ts",
        "import": "./dist/components/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "prepublishOnly": "pnpm build",
    "publish:verdaccio": "pnpm publish --registry http://localhost:4873 --no-git-checks",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@iconify/react": "catalog:",
    "@mui/material": "catalog:",
    "@mui/x-data-grid": "catalog:",
    "@mui/x-date-pickers": "catalog:",
    "@zapplib/core": "workspace:^",
    "dayjs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@iconify/react": "catalog:",
    "@mui/material": "catalog:",
    "@mui/x-data-grid": "catalog:",
    "@mui/x-date-pickers": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@zapplib/core": "workspace:*",
    "axios": "catalog:",
    "dayjs": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
